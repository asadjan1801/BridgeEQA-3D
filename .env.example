# Copy to agent_eval/.env and fill in. Never commit the filled-in file.

# Google AI Studio key: used by the gemini-3.1-flash-lite judge (Answer Correctness)
# and the Gemini 3.1 Flash-Lite baseline (litellm "gemini/" provider).
GEMINI_API_KEY=

# Only needed to re-run the original BridgeEQA OpenRouter baselines (run_experiments.py __main__).
OPENROUTER_API_KEY=

# Disable remote telemetry from logfire / openai-agents.
LOGFIRE_SEND_TO_LOGFIRE=false
OPENAI_AGENTS_DISABLE_TRACING=1

# Local vLLM endpoint (OpenAI-compatible) and data workspace root.
VLLM_SERVER_URL=http://localhost:8001/v1
BRIDGE_ROOT=/home/projects

# Optional: only for the original Gemini/Vertex AI PDF pipeline inherited from BridgeEQA
# (not used for the BridgeEQA-3D corpus, which was processed with a local Gemma 4 model).
# GOOGLE_BUCKET_NAME=
# VERTEXAI_PROJECT=
# VERTEXAI_LOCATION=us-south1
